{
  "name": "@mcpm/feature-launcher",
  "version": "0.3.0",
  "description": "Optional direct Minecraft launcher feature for MCPM",
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "mcpmFeature": {
    "apiVersion": 2,
    "entry": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaciejWlodarski/mcpm.git",
    "directory": "features/launcher"
  },
  "homepage": "https://github.com/MaciejWlodarski/mcpm#readme",
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "fflate": "^0.8.3"
  },
  "license": "MIT",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "18.19.130",
    "commander": "13.1.0",
    "typescript": "7.0.2"
  }
}
